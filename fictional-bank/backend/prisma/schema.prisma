// FirstDemo Bank - FICTIONAL demo application database schema
// This models a fake banking product for software-development demonstration only.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum AccountType {
  CHECKING
  SAVINGS
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  TRANSFER_IN
  TRANSFER_OUT
  ADMIN_CREDIT
  ADMIN_DEBIT
}

enum TransactionStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AdminRole {
  SUPPORT
  MANAGER
  SUPER_ADMIN
}

model User {
  id           String     @id @default(uuid())
  firstName    String
  lastName     String
  email        String     @unique
  phone        String?
  passwordHash String
  address      String?
  status       UserStatus @default(PENDING_VERIFICATION)
  emailVerified Boolean   @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  checkingAccount CheckingAccount?
  savingsAccount  SavingsAccount?
  transactions    Transaction[]
  depositRequests DepositRequest[]
  withdrawalRequests WithdrawalRequest[]
  notifications   Notification[]
  statements      Statement[]
  auditLogTargets AuditLog[] @relation("AuditTargetUser")
}

model CheckingAccount {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id])
  accountNumber String   @unique
  routingNumber String
  balance       Decimal  @default(0) @db.Decimal(14, 2)
  availableBalance Decimal @default(0) @db.Decimal(14, 2)
  createdAt     DateTime @default(now())
}

model SavingsAccount {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id])
  accountNumber String   @unique
  routingNumber String
  balance       Decimal  @default(0) @db.Decimal(14, 2)
  availableBalance Decimal @default(0) @db.Decimal(14, 2)
  createdAt     DateTime @default(now())
}

model Transaction {
  id              String            @id @default(uuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id])
  accountType     AccountType
  transactionType TransactionType
  amount          Decimal           @db.Decimal(14, 2)
  status          TransactionStatus @default(PENDING)
  description     String?
  createdAt       DateTime          @default(now())
}

model DepositRequest {
  id           String        @id @default(uuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id])
  accountType  AccountType
  amount       Decimal       @db.Decimal(14, 2)
  status       RequestStatus @default(PENDING)
  submittedAt  DateTime      @default(now())
  reviewedAt   DateTime?
  reviewedById String?
}

model WithdrawalRequest {
  id           String        @id @default(uuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id])
  accountType  AccountType
  amount       Decimal       @db.Decimal(14, 2)
  status       RequestStatus @default(PENDING)
  submittedAt  DateTime      @default(now())
  reviewedAt   DateTime?
  reviewedById String?
}

model Notification {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  title      String
  message    String
  readStatus Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model Statement {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  month        Int
  year         Int
  fileLocation String?
  createdAt    DateTime @default(now())
}

model Administrator {
  id           String     @id @default(uuid())
  username     String     @unique
  email        String     @unique
  passwordHash String
  role         AdminRole  @default(SUPPORT)
  twoFactorEnabled Boolean @default(false)
  twoFactorSecret  String?
  lastLogin    DateTime?
  createdAt    DateTime   @default(now())

  auditLogs    AuditLog[]
}

model AuditLog {
  id           String        @id @default(uuid())
  adminId      String
  admin        Administrator @relation(fields: [adminId], references: [id])
  action       String
  targetUserId String?
  targetUser   User?         @relation("AuditTargetUser", fields: [targetUserId], references: [id])
  description  String?
  ipAddress    String?
  timestamp    DateTime      @default(now())
}
